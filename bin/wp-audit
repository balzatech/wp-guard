#!/usr/bin/env bash
# shellcheck disable=SC2034  # shared state: assigned here, read by the modules and commands that source this file
# wp-audit - WordPress security audit (READ-ONLY)
#
#   wp-audit [quick] [options]
#
#   (no mode)   full review: files, server, database, public site and logs
#   quick       files and server only (no database, HTTP, probes or logs)
#
#   --format json   print the result as JSON (and nothing else) on stdout
#
# Saves report_*.txt, report_*.json and findings_*.tsv in ~/.wp_auditor/reports.
# Exit codes: 0 clean, 1 warnings, 2 alerts.

WPG_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck disable=SC1091
. "$WPG_HOME/lib/bootstrap.sh"
wpg_use config runtime findings scan inventory baseline correlate report notify audit

wpg_parse "$@"
MODE=full; [ "${WPG_ARGS[0]:-}" = quick ] && MODE=quick
wpg_load_config; wpg_init

WPG_CACHE=1   # incremental scanning (see lib/cache.sh)
inventory_run
audit_run

print_report "$NA" "$NW" "$NI" "$DUR" > "$TMP/report.raw"
sed "s/\x1b\[[0-9;]*m//g" "$TMP/report.raw" > "$TMP/report.txt"
print_json "$NA" "$NW" "$NI" "$DUR" > "$TMP/report.json"
report_save "$TMP/report.txt" "$TMP/report.json"
if [ "$FORMAT" = json ]; then
  cat "$TMP/report.json"                       # machine-readable: JSON only on stdout
  echo "Report saved in: $REPORT (JSON: ${REPORT%.txt}.json)" >&2
else
  cat "$TMP/report.raw"
  echo; echo "Report saved in: $REPORT"
fi

audit_exit_code; exit $?
