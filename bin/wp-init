#!/usr/bin/env bash
# shellcheck disable=SC2034  # shared state: assigned here, read by the modules and commands that source this file
# wp-init - Guided first-time setup (writes ~/.wp_auditor/config.sh)
#
#   wp-init [--path DIR] [--yes]
#
# Finds your WordPress site, reads its URL and current administrators from WordPress itself, and saves
# them as the trusted configuration. Run it only when you trust the current list of administrators.
# --yes accepts every detected value without asking.

WPG_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck disable=SC1091
. "$WPG_HOME/lib/bootstrap.sh"
wpg_use config notify notify_setup

YES=0; INIT_ARGS=()
for a in "$@"; do case "$a" in -y|--yes) YES=1 ;; *) INIT_ARGS+=("$a") ;; esac; done
wpg_parse "${INIT_ARGS[@]}"

STATE="${WPA_STATE:-$HOME/.wp_auditor}"
mkdir -p "$STATE/reports" && chmod 700 "$STATE" 2>/dev/null
CONF="$STATE/config.sh"

command -v wp >/dev/null 2>&1 || echo "Note: wp-cli ('wp') was not found. Database checks will be skipped; install it from https://wp-cli.org" >&2

# 1) which site
if [ -n "$CLI_PATH" ]; then WP_PATH=$CLI_PATH
else
  SITES=(); while IFS= read -r line; do [ -n "$line" ] && SITES+=("$line"); done <<< "$(wpg_find_wp)"   # no <(...): /dev/fd is missing on some hosts
  case ${#SITES[@]} in
    0) echo "No WordPress installation found. Run this inside your site folder or use --path DIR." >&2; exit 1 ;;
    1) WP_PATH=${SITES[0]} ;;
    *) echo "Several WordPress installations found:"
       for i in "${!SITES[@]}"; do echo "  $((i + 1))) ${SITES[$i]}"; done
       wpg_ask "Which one?" 1
       WP_PATH=${SITES[$((REPLY - 1))]:-} ;;
  esac
fi
[ -f "$WP_PATH/wp-config.php" ] || { echo "No wp-config.php in '$WP_PATH'." >&2; exit 1; }
WP_PATH=$(cd "$WP_PATH" && pwd -P)
echo "WordPress: $WP_PATH"

# 2) what WordPress says about itself
SITE_DET=${CLI_SITE:-$(wpg_wp_site_url "$WP_PATH")}
wpg_ask "Public site URL?" "${SITE_DET:-https://example.com}"; SITE=$REPLY
ADMINS_DET=$(wpg_wp_admins "$WP_PATH" | paste -sd' ' -)
if [ -n "$ADMINS_DET" ]; then
  echo "Current administrators: $ADMINS_DET"
  echo "Anyone NOT in this list will later be reported (and demoted by 'fix --apply'). Remove from WordPress first any admin you do not recognize."
fi
wpg_ask "Trusted administrator logins (space separated)?" "$ADMINS_DET"; ADMINS=$REPLY
# 3) save (keys we manage are replaced; anything else already in config.sh is kept)
if [ -f "$CONF" ]; then cp -p "$CONF" "$CONF.bak.$(date +%Y%m%d%H%M%S)"; echo "Existing config backed up."; else echo "# wp-guard configuration - generated by 'wp-guard init' on $(date '+%F %H:%M')" > "$CONF"; fi
wpg_conf_set WP_PATH "$WP_PATH"
wpg_conf_set SITE "$SITE"
wpg_conf_set ALLOWED_ADMINS "$ADMINS"
echo "Saved: $CONF"

# 4) alert channels: pick one (Slack recommended) and prove it works with a real test message
# shellcheck disable=SC1090
. "$CONF"
notify_setup_wizard

echo
echo "Next:"
echo "  wp-guard scan      # find problems (read-only)"
echo "  wp-guard fix       # preview the safe fixes; add --apply to perform them"
