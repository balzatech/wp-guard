#!/usr/bin/env bash
# shellcheck disable=SC2034  # shared state: assigned here, read by the modules and commands that source this file
# wp-restore - Puts back what wp-heal moved to quarantine
#
#   wp-restore DIR
#
# DIR = ~/.wp_auditor/quarantine/DATE  (with no argument it lists the available ones)

WPG_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck disable=SC1091
. "$WPG_HOME/lib/bootstrap.sh"
wpg_use config runtime restore

wpg_parse "$@"
MODE=restore
wpg_load_config; wpg_init

restore_run "${WPG_ARGS[0]:-}"; exit $?
